{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>philmichel/renovate-config"],
  "enabledManagers": ["dockerfile", "github-actions"],
  "packageRules": [
    {
      "description": "Auto-merge non-major base image updates once validate passes",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
