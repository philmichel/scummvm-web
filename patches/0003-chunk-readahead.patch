+// Implemented as a JS library function (backends/fs/emscripten/emscripten-fs-factory.js):
+// starts a fire-and-forget background fetch of the given byte range into the
+// local chunk-cache path. Initiating the fetch never suspends the wasm stack,
+// so this is safe to call from any context; the download itself progresses
+// while the engine yields (e.g. in delayMillis).
+extern "C" void EmscriptenVirtualFS_prefetchChunk(const char *url, const char *cachePath, double chunkStart, double chunkLength);
+
+void HttpReadStream::hintPrefetch(uint32 chunkIndex) {
+	if (_singleFullFile || chunkIndex >= _numChunks || isChunkDownloaded(chunkIndex))
+		return;
+	uint64 chunkStart = (uint64)chunkIndex * CHUNK_SIZE;
+	uint64 chunkLength = CHUNK_SIZE;
+	if (chunkStart + chunkLength > _size)
+		chunkLength = _size - chunkStart;
+	EmscriptenVirtualFS_prefetchChunk(_url.c_str(), getChunkPath(chunkIndex).c_str(),
+	                                  (double)chunkStart, (double)chunkLength);
+}
+
 #endif // EMSCRIPTEN

